<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FarmLink Zambia — From Harvest to Market, Zero Lost</title>
<style>
  :root{
    --green:#1b7a3d; --green-dark:#0f5128; --green-light:#e6f4ea;
    --gold:#e0a800; --earth:#7a5230; --bg:#f7f9f7;
    --ink:#1c2a22; --muted:#5f6f66; --card:#ffffff;
    --danger:#c0392b; --warn:#d68910; --info:#2471a3;
    --radius:14px; --shadow:0 6px 20px rgba(20,60,35,.10);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Segoe UI',system-ui,-apple-system,Roboto,sans-serif;
    background:var(--bg); color:var(--ink); line-height:1.5;
  }
  /* ---------- Header ---------- */
  header{
    background:linear-gradient(135deg,var(--green-dark),var(--green));
    color:#fff; padding:0; position:sticky; top:0; z-index:50;
    box-shadow:0 3px 14px rgba(0,0,0,.18);
  }
  .topbar{
    max-width:1180px;margin:0 auto;padding:14px 22px;
    display:flex;align-items:center;gap:16px;flex-wrap:wrap;
  }
  .logo{display:flex;align-items:center;gap:10px;font-size:1.35rem;font-weight:800;letter-spacing:.3px}
  .logo .mark{
    width:38px;height:38px;border-radius:50%;background:var(--gold);
    display:grid;place-items:center;font-size:.95rem;font-weight:900;color:#3a2c00;
    box-shadow:0 0 0 3px rgba(255,255,255,.25);
  }
  .tagline{font-size:.78rem;opacity:.85;font-weight:400;letter-spacing:.4px}
  .spacer{flex:1}
  .user-pill{
    background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);
    padding:7px 14px;border-radius:999px;font-size:.82rem;display:flex;align-items:center;gap:8px;
  }
  .user-pill .dot{width:9px;height:9px;border-radius:50%;background:#7CFC8A;box-shadow:0 0 6px #7CFC8A}
  /* ---------- Nav tabs ---------- */
  nav{background:var(--green-dark);}
  .navinner{max-width:1180px;margin:0 auto;display:flex;overflow-x:auto;gap:2px;padding:0 12px;}
  nav button{
    background:none;border:none;color:#cfe6d7;padding:12px 16px;font-size:.85rem;
    font-weight:600;cursor:pointer;white-space:nowrap;border-bottom:3px solid transparent;
    transition:.2s;font-family:inherit;
  }
  nav button:hover{color:#fff;background:rgba(255,255,255,.07)}
  nav button.active{color:#fff;border-bottom-color:var(--gold);background:rgba(255,255,255,.06)}
  /* ---------- Layout ---------- */
  main{max-width:1180px;margin:0 auto;padding:26px 22px 80px}
  .view{display:none;animation:fade .35s ease}
  .view.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .grid{display:grid;gap:18px}
  .g2{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}
  .g3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
  .g4{grid-template-columns:repeat(auto-fit,minmax(190px,1fr))}
  .card{
    background:var(--card);border-radius:var(--radius);padding:20px;
    box-shadow:var(--shadow);border:1px solid #e3ece5;
  }
  .card h3{font-size:1.02rem;margin-bottom:12px;color:var(--green-dark);display:flex;align-items:center;gap:8px}
  .muted{color:var(--muted);font-size:.85rem}
  h2.section{font-size:1.45rem;margin-bottom:6px;color:var(--green-dark)}
  p.lead{color:var(--muted);margin-bottom:22px;max-width:820px}
  /* ---------- Hero ---------- */
  .hero{
    background:linear-gradient(120deg,var(--green-dark),var(--green) 60%,#2e9e57);
    color:#fff;border-radius:20px;padding:38px 34px;margin-bottom:26px;position:relative;overflow:hidden;
  }
  .hero h1{font-size:2rem;margin-bottom:10px;letter-spacing:-.5px}
  .hero p{max-width:640px;opacity:.94;font-size:1rem}
  .hero .stats{display:flex;gap:28px;margin-top:24px;flex-wrap:wrap}
  .hero .stat .num{font-size:1.6rem;font-weight:800;color:var(--gold)}
  .hero .stat .lbl{font-size:.74rem;opacity:.85;letter-spacing:.4px;text-transform:uppercase}
  /* ---------- KPI tiles ---------- */
  .kpi{display:flex;align-items:center;gap:14px}
  .kpi .icon{
    width:48px;height:48px;border-radius:12px;background:var(--green-light);
    display:grid;place-items:center;font-size:.8rem;font-weight:800;flex-shrink:0;
    color:var(--green-dark);letter-spacing:.5px;text-transform:uppercase;
  }
  .kpi .val{font-size:1.5rem;font-weight:800;color:var(--green-dark);line-height:1.1}
  .kpi .cap{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
  /* ---------- Demand board ---------- */
  .bid{
    border-left:5px solid var(--green);background:#fbfefb;border-radius:10px;
    padding:14px 16px;margin-bottom:12px;transition:.18s;cursor:pointer;
  }
  .bid:hover{transform:translateX(4px);box-shadow:0 4px 14px rgba(20,60,35,.10)}
  .bid.priority{border-left-color:var(--gold)}
  .bid .bhead{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center}
  .bid .crop{font-weight:700;font-size:1rem}
  .bid .buyer{font-size:.82rem;color:var(--muted)}
  .bid .specs{display:flex;gap:14px;flex-wrap:wrap;margin-top:9px;font-size:.8rem;color:#33493c}
  .bid .specs span{background:var(--green-light);padding:3px 9px;border-radius:6px}
  .badge{
    font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:999px;
    text-transform:uppercase;letter-spacing:.5px;
  }
  .badge.open{background:#d5f5e0;color:#1b7a3d}
  .badge.closing{background:#fdebd0;color:#b9770e}
  .badge.verified{background:#d6eaf8;color:#1a5276}
  .badge.gold{background:#fdf2cf;color:#9a7d0a}
  /* ---------- Tables ---------- */
  table{width:100%;border-collapse:collapse;font-size:.85rem}
  th{text-align:left;padding:10px 8px;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border-bottom:2px solid #e3ece5}
  td{padding:10px 8px;border-bottom:1px solid #eef4ef}
  tr:hover td{background:#f6fbf7}
  /* ---------- Verification tiers ---------- */
  .tier{
    display:flex;gap:14px;align-items:flex-start;padding:13px 14px;border-radius:10px;
    border:1px solid #e3ece5;margin-bottom:9px;background:#fbfefb;
  }
  .tier .tnum{
    width:36px;height:36px;border-radius:50%;background:var(--green);color:#fff;
    display:grid;place-items:center;font-weight:800;flex-shrink:0;
  }
  .tier.t0 .tnum{background:#95a5a6}.tier.t1 .tnum{background:#5dade2}
  .tier.t2 .tnum{background:#52be80}.tier.t3 .tnum{background:#28a745}
  .tier.t4 .tnum{background:var(--gold);color:#3a2c00}
  .tier strong{display:block;font-size:.9rem}
  .tier .muted{margin-top:2px}
  /* ---------- Buttons / forms ---------- */
  button.btn{
    background:var(--green);color:#fff;border:none;padding:10px 18px;border-radius:9px;
    font-weight:600;cursor:pointer;font-size:.86rem;font-family:inherit;transition:.18s;
  }
  button.btn:hover{background:var(--green-dark);transform:translateY(-1px)}
  button.btn.ghost{background:#fff;color:var(--green-dark);border:1.5px solid var(--green)}
  button.btn.ghost:hover{background:var(--green-light)}
  button.btn.gold{background:var(--gold);color:#3a2c00}
  button.btn.sm{padding:6px 12px;font-size:.78rem}
  input,select{
    width:100%;padding:9px 11px;border:1.5px solid #cfdcd3;border-radius:8px;
    font-family:inherit;font-size:.86rem;background:#fff;color:var(--ink);
  }
  input:focus,select:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(27,122,61,.12)}
  label{font-size:.76rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:5px}
  .field{margin-bottom:13px}
  .formrow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  /* ---------- Loss tracker ---------- */
  .losscalc{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin:16px 0}
  .losscalc .box{background:#fbfefb;border:1px solid #e3ece5;border-radius:10px;padding:12px;text-align:center}
  .losscalc .box .v{font-size:1.25rem;font-weight:800;color:var(--green-dark)}
  .losscalc .box .k{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
  .losscalc .box.loss .v{color:var(--danger)}
  .progressbar{height:12px;background:#e8f0ea;border-radius:99px;overflow:hidden;margin-top:6px}
  .progressbar > div{height:100%;background:linear-gradient(90deg,var(--green),#54c47c);transition:width .6s ease}
  .progressbar .lossfill{background:linear-gradient(90deg,#e74c3c,#f39c12)}
  /* ---------- Loss map ---------- */
  .province-row{display:flex;align-items:center;gap:12px;margin-bottom:9px}
  .province-row .pname{width:110px;font-size:.82rem;font-weight:600}
  .province-row .pbar{flex:1;height:18px;background:#eef4ef;border-radius:6px;overflow:hidden}
  .province-row .pbar > div{height:100%;border-radius:6px;transition:width .6s}
  .province-row .pval{width:52px;text-align:right;font-size:.8rem;font-weight:700}
  /* ---------- SMS phone ---------- */
  .phone{
    max-width:330px;margin:0 auto;background:#1c2a22;border-radius:26px;padding:16px 12px;
    box-shadow:0 14px 40px rgba(0,0,0,.25);
  }
  .phone .screen{background:#e9f4ec;border-radius:16px;padding:14px;min-height:330px;display:flex;flex-direction:column}
  .phone .screenhead{text-align:center;font-size:.7rem;color:var(--muted);margin-bottom:10px;font-weight:600}
  .sms{
    background:#fff;border-radius:12px 12px 12px 4px;padding:10px 12px;margin-bottom:9px;
    font-size:.78rem;box-shadow:0 2px 6px rgba(0,0,0,.08);animation:pop .4s ease;
    border-left:3px solid var(--green);
  }
  .sms .meta{font-size:.62rem;color:var(--muted);margin-top:5px;text-transform:uppercase;letter-spacing:.4px}
  @keyframes pop{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:none}}
  /* ---------- User type cards ---------- */
  .usertype{border-top:4px solid var(--green);cursor:pointer;transition:.2s}
  .usertype:hover{transform:translateY(-4px);box-shadow:0 10px 26px rgba(20,60,35,.16)}
  .usertype h4{margin:8px 0 6px;font-size:1rem;color:var(--green-dark)}
  .usertype ul{margin:8px 0 0 18px;font-size:.8rem;color:var(--muted)}
  .usertype li{margin-bottom:3px}
  /* ---------- Toast ---------- */
  #toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(90px);
    background:var(--green-dark);color:#fff;padding:13px 24px;border-radius:12px;
    font-size:.86rem;box-shadow:0 8px 28px rgba(0,0,0,.28);z-index:999;
    opacity:0;transition:.35s;pointer-events:none;max-width:90vw;
  }
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  /* ---------- Misc ---------- */
  .pill{display:inline-block;font-size:.7rem;font-weight:700;padding:3px 10px;border-radius:999px;background:var(--green-light);color:var(--green-dark)}
  .divider{height:1px;background:#e3ece5;margin:18px 0}
  .flex{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .right{margin-left:auto}
  .hub{border-left:4px solid var(--earth);padding:12px 14px;background:#fdf9f3;border-radius:9px;margin-bottom:10px}
  .hub .hname{font-weight:700;font-size:.9rem}
  .hub .hmeta{font-size:.76rem;color:var(--muted);margin-top:3px}
  .wr{border-left:4px solid var(--info);background:#f4f9fd;padding:12px 14px;border-radius:9px;margin-bottom:10px}
  footer{text-align:center;padding:26px 20px;color:var(--muted);font-size:.78rem;border-top:1px solid #e3ece5;background:#fff}
  footer strong{color:var(--green-dark)}
  @media(max-width:640px){
    .hero h1{font-size:1.45rem}
    .formrow{grid-template-columns:1fr}
    .topbar{gap:8px}
  }
</style>
</head>
<body>

<header>
  <div class="topbar">
    <div class="logo">
      <div class="mark">FL</div>
      <div>
        FarmLink Zambia
        <div class="tagline">From Harvest to Market, Zero Lost.</div>
      </div>
    </div>
    <div class="spacer"></div>
    <div class="user-pill"><span class="dot"></span> Demo Mode · <span id="whoami">Cooperative Admin</span></div>
  </div>
  <nav class="navinner" id="tabs">
    <button class="active" data-view="dashboard">Dashboard</button>
    <button data-view="demand">Demand Board</button>
    <button data-view="loss">Loss Tracker</button>
    <button data-view="hubs">Aggregation Hubs</button>
    <button data-view="verify">Verification</button>
    <button data-view="sms">SMS Alerts</button>
    <button data-view="users">User Types</button>
    <button data-view="roadmap">Roadmap</button>
  </nav>
</header>

<main>

  <!-- ============ DASHBOARD ============ -->
  <section class="view active" id="view-dashboard">
    <div class="hero">
      <h1>Replacing the Painted Gate</h1>
      <p>FarmLink Zambia connects farmers, cooperatives, company buyers, business operators, and general buyers on one live, verified, nationwide coordination platform — so crops reach the market before they are lost.</p>
      <div class="stats">
        <div class="stat"><div class="num">30–40%</div><div class="lbl">Post-harvest losses (maize &amp; soy)</div></div>
        <div class="stat"><div class="num">156,699</div><div class="lbl">Registered cooperatives</div></div>
        <div class="stat"><div class="num">1%</div><div class="lbl">Cooperatives in marketing</div></div>
        <div class="stat"><div class="num">K10</div><div class="lbl">Tomato box · Jan 2026</div></div>
      </div>
    </div>

    <div class="grid g4" style="margin-bottom:22px">
      <div class="card kpi"><div class="icon">Farm</div><div><div class="val" id="kpiFarmers">1,248</div><div class="cap">Farmers registered</div></div></div>
      <div class="card kpi"><div class="icon">Coop</div><div><div class="val" id="kpiCoops">38</div><div class="cap">Cooperatives</div></div></div>
      <div class="card kpi"><div class="icon">Buyer</div><div><div class="val" id="kpiBuyers">27</div><div class="cap">Company buyers</div></div></div>
      <div class="card kpi"><div class="icon">Bids</div><div><div class="val" id="kpiBids">14</div><div class="cap">Open demand bids</div></div></div>
      <div class="card kpi"><div class="icon">Tons</div><div><div class="val" id="kpiTonnage">3,412 t</div><div class="cap">Tonnage listed</div></div></div>
      <div class="card kpi"><div class="icon">Deliv</div><div><div class="val" id="kpiDelivered">2,905 t</div><div class="cap">Delivered</div></div></div>
      <div class="card kpi"><div class="icon">Loss</div><div><div class="val" style="color:var(--danger)" id="kpiLoss">14.9%</div><div class="cap">Loss rate flagged</div></div></div>
      <div class="card kpi"><div class="icon">SMS</div><div><div class="val" id="kpiSms">9,870</div><div class="cap">SMS alerts sent</div></div></div>
    </div>

    <div class="grid g2">
      <div class="card">
        <h3>Latest Demand Bids</h3>
        <div id="dashBids"></div>
        <button class="btn ghost sm" style="margin-top:6px" onclick="showView('demand')">View full Demand Board →</button>
      </div>
      <div class="card">
        <h3>Loss Map of Zambia (pilot provinces)</h3>
        <div id="dashLossMap"></div>
        <p class="muted" style="margin-top:12px">Every harvest logged builds this data product — the gap between harvested and delivered tonnage, categorised as field, drying, storage or transport loss.</p>
      </div>
    </div>

    <div class="grid g2" style="margin-top:18px">
      <div class="card">
        <h3>Painted Gate → FarmLink</h3>
        <table>
          <tr><th>Painted Gate</th><th>FarmLink Zambia</th></tr>
          <tr><td>Static sign</td><td>Live demand board</td></tr>
          <tr><td>One-way</td><td>Two-way bids &amp; applications</td></tr>
          <tr><td>Visible to passers-by</td><td>Nationwide, verified</td></tr>
          <tr><td>No specs</td><td>Tonnage, grade, moisture, price</td></tr>
          <tr><td>Unverifiable</td><td>Tiered verification</td></tr>
          <tr><td>Undated</td><td>Buying windows</td></tr>
          <tr><td>Excludes smallholders</td><td>SMS for feature phones</td></tr>
        </table>
      </div>
      <div class="card">
        <h3>National Alignment</h3>
        <div class="flex" style="margin-bottom:10px"><span class="pill">Grow Zambia Agenda</span><span class="pill">Food Security Pack</span><span class="pill">Warehouse Receipt Act 2026</span><span class="pill">Data Protection Act 2021</span></div>
        <p class="muted">Targets 10M tonnes maize and 3M tonnes soybean by 2031. FarmLink strengthens market linkages for smallholders and provides the digital coordination layer that complements AGRA &amp; Ministry of Agriculture post-harvest loss projects.</p>
        <div class="divider"></div>
        <div class="flex"><strong>Budget:</strong> K5,000 <span class="muted">(hosting K3,000 · farm visits K1,000 · company visits K1,000)</span></div>
      </div>
    </div>
  </section>

  <!-- ============ DEMAND BOARD ============ -->
  <section class="view" id="view-demand">
    <h2 class="section">Live Demand Board</h2>
    <p class="lead">Buyers post full specifications — crop, tonnage, grade, moisture, price and delivery date. Farmers and cooperatives apply directly. No more painted signs.</p>

    <div class="card" style="margin-bottom:18px">
      <h3>Filter Bids</h3>
      <div class="formrow">
        <div class="field"><label>Crop</label>
          <select id="filterCrop" onchange="renderBids()">
            <option value="">All crops</option><option>Maize</option><option>Soybean</option>
            <option>Groundnuts</option><option>Beans</option><option>Tomatoes</option>
          </select>
        </div>
        <div class="field"><label>Province</label>
          <select id="filterProvince" onchange="renderBids()">
            <option value="">All provinces</option><option>Lusaka</option><option>Eastern</option>
            <option>Central</option><option>Copperbelt</option><option>Southern</option>
          </select>
        </div>
      </div>
      <div class="flex">
        <button class="btn" onclick="renderBids()">Apply Filters</button>
        <button class="btn ghost" onclick="openBidForm()">+ Post a Demand Bid</button>
        <span class="muted right" id="bidCount"></span>
      </div>
    </div>

    <div id="bidList"></div>

    <div class="card" id="bidForm" style="display:none;margin-top:18px;border:2px solid var(--green)">
      <h3>Post a Demand Bid</h3>
      <div class="formrow">
        <div class="field"><label>Crop</label><select id="nfCrop"><option>Maize</option><option>Soybean</option><option>Groundnuts</option><option>Beans</option><option>Tomatoes</option></select></div>
        <div class="field"><label>Quantity (tonnes)</label><input id="nfQty" type="number" value="100" min="1"></div>
        <div class="field"><label>Grade</label><select id="nfGrade"><option>Grade A</option><option>Grade B</option><option>Grade C</option></select></div>
        <div class="field"><label>Max moisture (%)</label><input id="nfMoisture" type="number" value="13"></div>
        <div class="field"><label>Price (K / tonne)</label><input id="nfPrice" type="number" value="4500"></div>
        <div class="field"><label>Delivery province</label><select id="nfProv"><option>Lusaka</option><option>Eastern</option><option>Central</option><option>Copperbelt</option><option>Southern</option></select></div>
      </div>
      <div class="field"><label>Buyer name</label><input id="nfBuyer" value="Demo Milling Co."></div>
      <div class="flex"><button class="btn" onclick="submitBid()">Publish Bid</button><button class="btn ghost" onclick="closeBidForm()">Cancel</button></div>
    </div>
  </section>

  <!-- ============ LOSS TRACKER ============ -->
  <section class="view" id="view-loss">
    <h2 class="section">Loss Tracker</h2>
    <p class="lead">Log expected harvest and actual delivered tonnage. The platform calculates the gap and categorises it — building the Loss Map of Zambia.</p>

    <div class="grid g2">
      <div class="card">
        <h3>Log a Harvest</h3>
        <div class="formrow">
          <div class="field"><label>Crop</label><select id="lossCrop"><option>Maize</option><option>Soybean</option><option>Groundnuts</option><option>Beans</option></select></div>
          <div class="field"><label>Province</label><select id="lossProv"><option>Eastern</option><option>Central</option><option>Lusaka</option><option>Copperbelt</option><option>Southern</option></select></div>
          <div class="field"><label>Expected harvest (t)</label><input id="lossExpected" type="number" value="120" min="0" oninput="calcLoss()"></div>
          <div class="field"><label>Actual delivered (t)</label><input id="lossActual" type="number" value="98" min="0" oninput="calcLoss()"></div>
        </div>
        <div class="field"><label>Loss category</label>
          <select id="lossCategory"><option>Field loss</option><option>Drying loss</option><option>Storage loss</option><option>Transport loss</option></select>
        </div>
        <div class="losscalc">
          <div class="box"><div class="v" id="lcExpected">120</div><div class="k">Expected t</div></div>
          <div class="box"><div class="v" id="lcActual">98</div><div class="k">Delivered t</div></div>
          <div class="box loss"><div class="v" id="lcGap">22</div><div class="k">Gap t</div></div>
          <div class="box loss"><div class="v" id="lcPct">18.3%</div><div class="k">Loss rate</div></div>
        </div>
        <div class="progressbar"><div id="lossBar" class="lossfill" style="width:18%"></div></div>
        <button class="btn" style="margin-top:16px" onclick="saveLoss()">Record Loss Entry</button>
      </div>

      <div class="card">
        <h3>Loss Map of Zambia</h3>
        <p class="muted" style="margin-bottom:14px">Aggregated loss rates by province from recorded entries.</p>
        <div id="lossMapFull"></div>
        <div class="divider"></div>
        <h3>Recent Entries</h3>
        <table>
          <thead><tr><th>Crop</th><th>Province</th><th>Expected</th><th>Delivered</th><th>Loss</th></tr></thead>
          <tbody id="lossEntries"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ HUBS ============ -->
  <section class="view" id="view-hubs">
    <h2 class="section">Aggregation Hub Model</h2>
    <p class="lead">FarmLink doesn't connect one farmer to one buyer. It connects clusters of farmers to bulk buyers through physical aggregation points — cooperative buildings, agro-dealer shops, warehouses.</p>
    <div class="grid g2">
      <div class="card">
        <h3>Active Aggregation Hubs</h3>
        <div id="hubList"></div>
      </div>
      <div class="card">
        <h3>Register Intake at Hub</h3>
        <div class="field"><label>Hub</label>
          <select id="intakeHub"><option>Chipata Cooperative Hub</option><option>Mkushi Agro-Dealer Point</option><option>Mongu Collection Centre</option></select>
        </div>
        <div class="formrow">
          <div class="field"><label>Farmer / member</label><input id="intakeFarmer" value="Grace Phiri"></div>
          <div class="field"><label>Crop</label><select id="intakeCrop"><option>Maize</option><option>Soybean</option><option>Groundnuts</option></select></div>
          <div class="field"><label>Tonnage received (t)</label><input id="intakeTons" type="number" value="8" min="0"></div>
          <div class="field"><label>Grade</label><select id="intakeGrade"><option>Grade A</option><option>Grade B</option><option>Grade C</option></select></div>
        </div>
        <div class="field"><label>Moisture (%)</label><input id="intakeMoisture" type="number" value="12.5" step="0.1"></div>
        <button class="btn" onclick="addIntake()">Log Intake</button>
        <div class="divider"></div>
        <h3>Aggregated Bulk Lots</h3>
        <div id="bulkLots"></div>
      </div>
    </div>
  </section>

  <!-- ============ VERIFICATION ============ -->
  <section class="view" id="view-verify">
    <h2 class="section">Tiered Trust Without Payment</h2>
    <p class="lead">Because FarmLink doesn't process payments, trust is built through verification rather than escrow. Buyers filter by tier; farmers climb the ladder.</p>
    <div class="grid g2">
      <div class="card">
        <h3>Verification Tiers</h3>
        <div class="tier t0"><div class="tnum">0</div><div><strong>Tier 0 — Phone verified</strong><div class="muted">A verified phone number. Entry level.</div></div></div>
        <div class="tier t1"><div class="tnum">1</div><div><strong>Tier 1 — National ID</strong><div class="muted">Verified national ID number.</div></div></div>
        <div class="tier t2"><div class="tnum">2</div><div><strong>Tier 2 — Cooperative vouching</strong><div class="muted">Cooperative confirms the person is a real farmer.</div></div></div>
        <div class="tier t3"><div class="tnum">3</div><div><strong>Tier 3 — Extension officer</strong><div class="muted">Officer confirms the farm exists and farmer is active.</div></div></div>
        <div class="tier t4"><div class="tnum">4</div><div><strong>Tier 4 — Warehouse receipt</strong><div class="muted">Grain stored in a certified facility; receipt-backed.</div></div></div>
      </div>
      <div class="card">
        <h3>Warehouse Receipts <span class="badge verified" style="margin-left:auto">Act No. 7 of 2026</span></h3>
        <p class="muted" style="margin-bottom:14px">Farmers who deposit grain in certified warehouses receive negotiable receipts — usable as loan collateral or traded as a proxy for the grain.</p>
        <div id="receiptList"></div>
        <button class="btn ghost sm" onclick="listReceipt()" style="margin-top:6px">List a Warehouse Receipt</button>
      </div>
    </div>
  </section>

  <!-- ============ SMS ============ -->
  <section class="view" id="view-sms">
    <h2 class="section">SMS Notification Layer</h2>
    <p class="lead">A significant portion of farmers use basic feature phones. FarmLink sends concise SMS alerts in the user's chosen local language — no smartphone required.</p>
    <div class="grid g2">
      <div class="card">
        <h3>Language &amp; Preferences</h3>
        <div class="field"><label>Chosen language</label>
          <select id="smsLang" onchange="previewSms()">
            <option value="en">English</option><option value="bem">Bemba</option>
            <option value="nya">Nyanja</option><option value="ton">Tonga</option><option value="loz">Lozi</option>
          </select>
        </div>
        <div class="field"><label>Alert types</label>
          <div class="flex"><label style="text-transform:none;font-weight:400"><input type="checkbox" checked style="width:auto"> Buyer demand</label>
          <label style="text-transform:none;font-weight:400"><input type="checkbox" checked style="width:auto"> Price updates</label>
          <label style="text-transform:none;font-weight:400"><input type="checkbox" checked style="width:auto"> Bid matches</label>
          <label style="text-transform:none;font-weight:400"><input type="checkbox" checked style="width:auto"> FRA windows</label></div>
        </div>
        <button class="btn" onclick="sendDemoSms()">Send Demo Alert</button>
        <div class="divider"></div>
        <div class="flex"><span class="pill" id="smsCount">9,870</span><span class="muted">total SMS delivered</span></div>
        <p class="muted" style="margin-top:10px">Supports concatenated messages, delivery receipts and multi-language templates via an aggregator such as Africa's Talking or a local Zambian provider.</p>
      </div>
      <div class="card">
        <h3>Phone Preview</h3>
        <div class="phone"><div class="screen">
          <div class="screenhead">FarmLink Zambia · SMS</div>
          <div id="smsInbox"></div>
        </div></div>
      </div>
    </div>
  </section>

  <!-- ============ USERS ============ -->
  <section class="view" id="view-users">
    <h2 class="section">Five User Types</h2>
    <p class="lead">FarmLink is a multi-sided platform. Each account type has tailored capabilities.</p>
    <div class="grid g3" id="userCards"></div>
  </section>

  <!-- ============ ROADMAP ============ -->
  <section class="view" id="view-roadmap">
    <h2 class="section">Implementation Roadmap · 36 Months</h2>
    <p class="lead">Four phases, from a maize pilot to national coverage.</p>
    <div class="grid g2">
      <div class="card" style="border-top:5px solid var(--green)">
        <h3>Phase 1 · Months 1–6</h3>
        <p class="muted">Loss Tracker and aggregation pilot (maize, Eastern/Central Province). 5 cooperatives, 200 farmers. Manual matching. SMS alerts. 5–10 buyers.</p>
        <div class="progressbar"><div style="width:35%"></div></div>
      </div>
      <div class="card" style="border-top:5px solid var(--green)">
        <h3>Phase 2 · Months 7–12</h3>
        <p class="muted">Quality badges (cooperative-certified, lab-tested), ZACA warehouse integration, warehouse receipts as verified listings, expanded SMS, General Accounts.</p>
        <div class="progressbar"><div style="width:20%"></div></div>
      </div>
      <div class="card" style="border-top:5px solid var(--gold)">
        <h3>Phase 3 · Year 2</h3>
        <p class="muted">Soybean, beans, groundnuts. Expand to 3 provinces. Launch the Loss Map data product. Social features (feed, follow, news). Business Operator accounts.</p>
        <div class="progressbar"><div style="width:8%"></div></div>
      </div>
      <div class="card" style="border-top:5px solid var(--gold)">
        <h3>Phase 4 · Year 3</h3>
        <p class="muted">National coverage (all 10 provinces). Formal FRA integration. Cold chain logistics for perishables. Livestock and other commodities.</p>
        <div class="progressbar"><div style="width:2%"></div></div>
      </div>
    </div>
    <div class="card" style="margin-top:18px">
      <h3>Key Risks</h3>
      <div class="grid g3">
        <div><strong>Weak cooperative capacity</strong><p class="muted">Mitigate with training and COMACO-style partnerships.</p></div>
        <div><strong>Trust in no-payment model</strong><p class="muted">Strong reputation system and verification tiers.</p></div>
        <div><strong>Data accuracy</strong><p class="muted">Incentives for accurate tonnage reporting.</p></div>
        <div><strong>FRA integration delays</strong><p class="muted">Treat FRA as optional channel, not core.</p></div>
        <div><strong>Low digital literacy</strong><p class="muted">SMS, local languages, cooperative agents.</p></div>
        <div><strong>Disintermediation</strong><p class="muted">Add value via aggregation, QA, logistics, receipts.</p></div>
      </div>
    </div>
  </section>

</main>

<footer>
  <strong>FarmLink Zambia</strong> — From Harvest to Market, Zero Lost. · Demo prepared for Zambia Research and Development Centre · October 2026
</footer>

<div id="toast"></div>

<script>
/* ============================================================
   STATE
   ============================================================ */
const state = {
  bids: [
    {crop:'Maize', buyer:'National Milling Co.', qty:500, grade:'Grade A', moisture:13, price:4800, province:'Lusaka', deadline:'2026-11-15', verified:true, priority:false, status:'open'},
    {crop:'Soybean', buyer:'Kafue Feed Manufacturers', qty:300, grade:'Grade A', moisture:12, price:6200, province:'Lusaka', deadline:'2026-11-30', verified:true, priority:true, status:'open'},
    {crop:'Maize', buyer:'Choma Grain Traders', qty:150, grade:'Grade B', moisture:14, price:3900, province:'Southern', deadline:'2026-11-20', verified:false, priority:false, status:'closing'},
    {crop:'Groundnuts', buyer:'Eastern Oil Processors', qty:80, grade:'Grade A', moisture:9, price:8500, province:'Eastern', deadline:'2026-12-05', verified:true, priority:false, status:'open'},
    {crop:'Beans', buyer:'Lusaka Market Vendors Assoc.', qty:40, grade:'Grade B', moisture:12, price:7200, province:'Lusaka', deadline:'2026-11-18', verified:false, priority:false, status:'open'},
    {crop:'Tomatoes', buyer:'Fresh Produce Zambia', qty:25, grade:'Grade A', moisture:null, price:2800, province:'Lusaka', deadline:'2026-11-10', verified:true, priority:true, status:'closing'},
    {crop:'Maize', buyer:'Copperbelt Milling', qty:400, grade:'Grade A', moisture:13, price:4650, province:'Copperbelt', deadline:'2026-11-25', verified:true, priority:false, status:'open'}
  ],
  lossEntries: [
    {crop:'Maize', province:'Eastern', expected:120, actual:98, category:'Storage loss'},
    {crop:'Maize', province:'Central', expected:200, actual:172, category:'Transport loss'},
    {crop:'Soybean', province:'Eastern', expected:80, actual:69, category:'Field loss'},
    {crop:'Groundnuts', province:'Eastern', expected:45, actual:40, category:'Drying loss'}
  ],
  hubs: [
    {name:'Chipata Cooperative Hub', province:'Eastern', members:142, tonnage:386, crops:'Maize, Groundnuts'},
    {name:'Mkushi Agro-Dealer Point', province:'Central', members:88, tonnage:214, crops:'Maize, Soybean'},
    {name:'Mongu Collection Centre', province:'Western', members:63, tonnage:97, crops:'Maize, Beans'}
  ],
  receipts: [
    {id:'WR-2026-0412', farmer:'Grace Phiri', warehouse:'ZACA Lusaka Certified', crop:'Maize', tons:32, grade:'Grade A', status:'Listed'},
    {id:'WR-2026-0398', farmer:'Moses Banda', warehouse:'Chipata Certified Store', crop:'Soybean', tons:18, grade:'Grade A', status:'Collateralised'},
    {id:'WR-2026-0377', farmer:'Esther Zulu', warehouse:'Kabwe Certified Warehouse', crop:'Maize', tons:45, grade:'Grade B', status:'Listed'}
  ],
  sms: [],
  bulkLots: [
    {lot:'LOT-CHP-101', crop:'Maize', grade:'Grade A', tons:386, hub:'Chipata Cooperative Hub', status:'Listed'},
    {lot:'LOT-MKS-204', crop:'Maize', grade:'Grade B', tons:214, hub:'Mkushi Agro-Dealer Point', status:'Pending QA'}
  ],
  kpi: {farmers:1248, coops:38, buyers:27, bids:14, tonnage:3412, delivered:2905, sms:9870}
};

const SMS_TEMPLATES = {
  demand: {
    en:'FarmLink: National Milling needs 500t Grade A maize @ K4,800/t, Lusaka, by 15 Nov. Reply APPLY to bid.',
    bem:'FarmLink: National Milling balefwaya 500t Grade A maize @ K4,800/t, Lusaka, mpaka 15 Nov. Yankho APPLY.',
    nya:'FarmLink: National Milling akufuna 500t Grade A maize @ K4,800/t, Lusaka, pofika 15 Nov. Yankhani APPLY.',
    ton:'FarmLink: National Milling ulayanda 500t Grade A maize @ K4,800/t, Lusaka, kusika 15 Nov. Amba APPLY.',
    loz:'FarmLink: National Milling ba batisiza 500t Grade A maize @ K4,800/t, Lusaka, ku fita 15 Nov. Alaba APPLY.'
  },
  price: {
    en:'FarmLink PRICE: Soybean now K6,200/t (up 3%). Maize K4,800/t. Sell while demand is high.',
    bem:'FarmLink PRICE: Soybean nomba K6,200/t (kukwela 3%). Maize K4,800/t. Shitisha inshita iyi.',
    nya:'FarmLink PRICE: Soybean tsopano K6,200/t (kukwera 3%). Maize K4,800/t. Gulitsani tsopano.',
    ton:'FarmLink PRICE: Soybean ino K6,200/t (kukwela 3%). Maize K4,800/t. Shitisha mangu.',
    loz:'FarmLink PRICE: Soybean cwale K6,200/t (kuhuha 3%). Maize K4,800/t. Rekisa cwale.'
  },
  match: {
    en:'FarmLink: Your maize listing matched a buyer bid. Log in or visit your cooperative to confirm.',
    bem:'FarmLink: Icilandushi ca maize wako cafikwa ku bid ya buyer. Ingila pa app ku confirm.',
    nya:'FarmLink: Maize yanu yalumikizana ndi bid ya buyer. Lowani mu app kutsimikiza.',
    ton:'FarmLink: Maize yako ibhona kufwana amba bid ya buyer. Ngula mu app ku sika.',
    loz:'FarmLink: Maize yenu i bonahala ku bid ya buyer. Kena mu app ku tiya.'
  },
  fra: {
    en:'FarmLink FRA: Food Reserve Agency maize buying window opens 1 Nov at Chipata depot. Grade A @ K3,800/t. Close 30 Nov.',
    bem:'FarmLink FRA: FRA maize buying window yaisula 1 Nov pa Chipata depot. Grade A @ K3,800/t. Yaisala 30 Nov.',
    nya:'FarmLink FRA: FRA maize buying window yatsegulidwa 1 Nov ku Chipata depot. Grade A @ K3,800/t. Yatseka 30 Nov.',
    ton:'FarmLink FRA: FRA maize buying window yazulwa 1 Nov ku Chipata depot. Grade A @ K3,800/t. Yazala 30 Nov.',
    loz:'FarmLink FRA: FRA maize buying window i zwahala 1 Nov ku Chipata depot. Grade A @ K3,800/t. I kala 30 Nov.'
  }
};

/* ============================================================
   NAVIGATION
   ============================================================ */
function showView(id){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+id).classList.add('active');
  document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('active', b.dataset.view===id));
  window.scrollTo({top:0,behavior:'smooth'});
}
document.getElementById('tabs').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(b) showView(b.dataset.view);
});

/* ============================================================
   TOAST
   ============================================================ */
let toastTimer;
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 3200);
}

/* ============================================================
   DASHBOARD
   ============================================================ */
function renderDashBids(){
  const el = document.getElementById('dashBids');
  el.innerHTML = state.bids.slice(0,3).map(b=>`
    <div class="bid ${b.priority?'priority':''}" onclick="showView('demand')">
      <div class="bhead">
        <div><div class="crop">${b.crop}</div><div class="buyer">${b.buyer}</div></div>
        <span class="badge ${b.status==='closing'?'closing':'open'}">${b.status==='closing'?'Closing soon':'Open'}</span>
      </div>
      <div class="specs"><span>${b.qty}t</span><span>${b.grade}</span><span>K${b.price.toLocaleString()}/t</span><span>${b.province}</span></div>
    </div>`).join('');
}

function lossRate(entries){
  const exp = entries.reduce((s,e)=>s+e.expected,0);
  const act = entries.reduce((s,e)=>s+e.actual,0);
  return exp? ((exp-act)/exp*100) : 0;
}

function renderLossMap(target){
  const byProv = {};
  state.lossEntries.forEach(e=>{
    if(!byProv[e.province]) byProv[e.province]={exp:0,act:0};
    byProv[e.province].exp+=e.expected; byProv[e.province].act+=e.actual;
  });
  const maxRate = Math.max(...Object.values(byProv).map(p=>p.exp?(p.exp-p.act)/p.exp*100:0), 1);
  document.getElementById(target).innerHTML = Object.entries(byProv).map(([prov,d])=>{
    const rate = d.exp? (d.exp-d.act)/d.exp*100 : 0;
    const w = Math.max(4, rate/maxRate*100);
    const color = rate>20?'#e74c3c':rate>12?'#f39c12':'#27ae60';
    return `<div class="province-row">
      <div class="pname">${prov}</div>
      <div class="pbar"><div style="width:${w}%;background:${color}"></div></div>
      <div class="pval" style="color:${color}">${rate.toFixed(1)}%</div>
    </div>`;
  }).join('');
}

function updateKPIs(){
  const k = state.kpi;
  document.getElementById('kpiFarmers').textContent = k.farmers.toLocaleString();
  document.getElementById('kpiCoops').textContent = k.coops;
  document.getElementById('kpiBuyers').textContent = k.buyers;
  document.getElementById('kpiBids').textContent = state.bids.length;
  document.getElementById('kpiTonnage').textContent = k.tonnage.toLocaleString()+' t';
  document.getElementById('kpiDelivered').textContent = k.delivered.toLocaleString()+' t';
  const totalExp = state.lossEntries.reduce((s,e)=>s+e.expected,0);
  const totalAct = state.lossEntries.reduce((s,e)=>s+e.actual,0);
  const rate = totalExp? ((totalExp-totalAct)/totalExp*100) : 0;
  document.getElementById('kpiLoss').textContent = rate.toFixed(1)+'%';
  document.getElementById('kpiSms').textContent = k.sms.toLocaleString();
  document.getElementById('smsCount').textContent = k.sms.toLocaleString();
}

/* ============================================================
   DEMAND BOARD
   ============================================================ */
function renderBids(){
  const fc = document.getElementById('filterCrop').value;
  const fp = document.getElementById('filterProvince').value;
  const list = state.bids.filter(b=>(!fc||b.crop===fc)&&(!fp||b.province===fp));
  document.getElementById('bidCount').textContent = list.length+' bid(s)';
  const el = document.getElementById('bidList');
  if(!list.length){ el.innerHTML='<div class="card muted">No bids match your filters.</div>'; return; }
  el.innerHTML = list.map((b,i)=>`
    <div class="bid ${b.priority?'priority':''}">
      <div class="bhead">
        <div>
          <div class="crop">${b.crop} — ${b.qty} tonnes</div>
          <div class="buyer">${b.buyer} ${b.verified?'<span class="badge verified">Verified</span>':''}</div>
        </div>
        <div class="flex">
          <span class="badge ${b.status==='closing'?'closing':'open'}">${b.status==='closing'?'Closing soon':'Open'}</span>
          <button class="btn sm" onclick="applyBid(${state.bids.indexOf(b)})">Apply</button>
        </div>
      </div>
      <div class="specs">
        <span>${b.grade}</span>
        ${b.moisture?`<span>≤${b.moisture}% moisture</span>`:''}
        <span>K${b.price.toLocaleString()}/t</span>
        <span>${b.province}</span>
        <span>By ${b.deadline}</span>
      </div>
    </div>`).join('');
}

function applyBid(idx){
  const b = state.bids[idx];
  toast(`Application sent to ${b.buyer} for ${b.qty}t of ${b.crop}. You'll get an SMS confirmation.`);
  addSms('match', 'Bid match confirmed — application sent.');
}

function openBidForm(){ document.getElementById('bidForm').style.display='block'; }
function closeBidForm(){ document.getElementById('bidForm').style.display='none'; }

function submitBid(){
  const crop = document.getElementById('nfCrop').value;
  const qty = +document.getElementById('nfQty').value;
  const grade = document.getElementById('nfGrade').value;
  const moisture = +document.getElementById('nfMoisture').value;
  const price = +document.getElementById('nfPrice').value;
  const province = document.getElementById('nfProv').value;
  const buyer = document.getElementById('nfBuyer').value || 'Anonymous Buyer';
  if(!qty||qty<1){ toast('Please enter a valid quantity.'); return; }
  state.bids.unshift({
    crop, buyer, qty, grade, moisture, price, province,
    deadline:new Date(Date.now()+14*864e5).toISOString().slice(0,10),
    verified:true, priority:false, status:'open'
  });
  closeBidForm(); renderBids(); renderDashBids(); updateKPIs();
  toast(`Bid published: ${qty}t ${crop} @ K${price.toLocaleString()}/t.`);
}

/* ============================================================
   LOSS TRACKER
   ============================================================ */
function calcLoss(){
  const exp = +document.getElementById('lossExpected').value || 0;
  const act = +document.getElementById('lossActual').value || 0;
  const gap = Math.max(0, exp-act);
  const pct = exp? gap/exp*100 : 0;
  document.getElementById('lcExpected').textContent = exp;
  document.getElementById('lcActual').textContent = act;
  document.getElementById('lcGap').textContent = gap;
  document.getElementById('lcPct').textContent = pct.toFixed(1)+'%';
  const bar = document.getElementById('lossBar');
  bar.style.width = Math.min(100,pct)+'%';
  bar.style.background = pct>20?'linear-gradient(90deg,#e74c3c,#c0392b)':pct>12?'linear-gradient(90deg,#f39c12,#e67e22)':'linear-gradient(90deg,#27ae60,#54c47c)';
}

function saveLoss(){
  const crop = document.getElementById('lossCrop').value;
  const province = document.getElementById('lossProv').value;
  const expected = +document.getElementById('lossExpected').value || 0;
  const actual = +document.getElementById('lossActual').value || 0;
  const category = document.getElementById('lossCategory').value;
  if(!expected||expected<1){ toast('Enter expected harvest.'); return; }
  if(actual>expected){ toast('Delivered cannot exceed expected harvest.'); return; }
  state.lossEntries.unshift({crop, province, expected, actual, category});
  renderLossEntries(); renderLossMap('lossMapFull'); renderLossMap('dashLossMap'); updateKPIs();
  toast(`Loss entry recorded: ${(expected-act).toFixed(0)}t gap (${((expected-act)/expected*100).toFixed(1)}%) — ${category}.`);
}

function renderLossEntries(){
  document.getElementById('lossEntries').innerHTML = state.lossEntries.slice(0,6).map(e=>{
    const gap = e.expected-e.actual;
    const pct = e.expected? gap/e.expected*100 : 0;
    const color = pct>20?'#c0392b':pct>12?'#d68910':'#1b7a3d';
    return `<tr><td>${e.crop}</td><td>${e.province}</td><td>${e.expected}t</td><td>${e.actual}t</td>
      <td style="color:${color};font-weight:700">${gap}t (${pct.toFixed(1)}%)</td></tr>`;
  }).join('');
}

/* ============================================================
   HUBS
   ============================================================ */
function renderHubs(){
  document.getElementById('hubList').innerHTML = state.hubs.map(h=>`
    <div class="hub">
      <div class="hname">${h.name}</div>
      <div class="hmeta">${h.province} · ${h.members} members · ${h.tonnage}t aggregated · ${h.crops}</div>
    </div>`).join('');
  renderBulkLots();
}

function renderBulkLots(){
  document.getElementById('bulkLots').innerHTML = state.bulkLots.map(l=>`
    <div class="bid" style="border-left-color:var(--earth)">
      <div class="bhead"><div><div class="crop">${l.lot} · ${l.crop}</div><div class="buyer">${l.hub}</div></div>
      <span class="badge ${l.status==='Listed'?'open':'closing'}">${l.status}</span></div>
      <div class="specs"><span>${l.tons}t</span><span>${l.grade}</span></div>
    </div>`).join('');
}

function addIntake(){
  const hub = document.getElementById('intakeHub').value;
  const farmer = document.getElementById('intakeFarmer').value || 'Unknown farmer';
  const crop = document.getElementById('intakeCrop').value;
  const tons = +document.getElementById('intakeTons').value || 0;
  const grade = document.getElementById('intakeGrade').value;
  const moisture = +document.getElementById('intakeMoisture').value || 0;
  if(tons<1){ toast('Enter a valid tonnage.'); return; }
  const h = state.hubs.find(x=>x.name===hub);
  if(h){ h.tonnage += tons; }
  state.bulkLots.unshift({
    lot:'LOT-'+Math.random().toString(36).slice(2,7).toUpperCase(),
    crop, grade, tons, hub, status:'Pending QA'
  });
  renderHubs(); updateKPIs();
  toast(`Intake logged: ${farmer} delivered ${tons}t ${grade} ${crop} (${moisture}% moisture) to ${hub}.`);
}

/* ============================================================
   VERIFICATION / RECEIPTS
   ============================================================ */
function renderReceipts(){
  document.getElementById('receiptList').innerHTML = state.receipts.map(r=>`
    <div class="wr">
      <div class="flex"><strong>${r.id}</strong><span class="badge verified">${r.status}</span></div>
      <div class="muted" style="margin-top:4px">${r.farmer} · ${r.warehouse} · ${r.tons}t ${r.crop} (${r.grade})</div>
    </div>`).join('');
}

function listReceipt(){
  const id = 'WR-2026-'+String(Math.floor(1000+Math.random()*9000));
  state.receipts.unshift({id, farmer:'Demo Farmer', warehouse:'ZACA Certified Warehouse', crop:'Maize', tons:20, grade:'Grade A', status:'Listed'});
  renderReceipts();
  toast(`Warehouse receipt ${id} listed for sale on the platform.`);
}

/* ============================================================
   SMS
   ============================================================ */
function addSms(type, note){
  const lang = document.getElementById('smsLang').value;
  const text = SMS_TEMPLATES[type][lang] || SMS_TEMPLATES[type].en;
  state.sms.unshift({text, note, time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})});
  if(state.sms.length>6) state.sms.pop();
  renderSmsInbox();
  state.kpi.sms++;
  updateKPIs();
}

function renderSmsInbox(){
  document.getElementById('smsInbox').innerHTML = state.sms.map(s=>`
    <div class="sms">${s.text}<div class="meta">${s.time} · ${s.note}</div></div>`).join('')
    || '<div class="muted" style="text-align:center;margin-top:40px">No messages yet.<br>Send a demo alert</div>';
}

function sendDemoSms(){
  const types = ['demand','price','match','fra'];
  const t = types[Math.floor(Math.random()*types.length)];
  addSms(t, 'SMS alert dispatched');
  toast('SMS alert sent to farmers in the pilot area.');
}

function previewSms(){
  if(state.sms.length){
    const last = state.sms[0];
    const type = Object.keys(SMS_TEMPLATES).find(k => SMS_TEMPLATES[k].en === last.text || Object.values(SMS_TEMPLATES[k]).includes(last.text)) || 'demand';
    addSms(type, 'Language changed');
  }
}

/* ============================================================
   USER TYPES
   ============================================================ */
const USER_TYPES = [
  {name:'Farmer', desc:'Individual farmers with farm profiles, crop listings and Loss Tracker.',
   bullets:['Phone + national ID (Tier 1)','Log crops planted & expected harvest','List tonnage for sale','Apply to buyer bids','Receive SMS alerts','Rate buyers']},
  {name:'Cooperative', desc:'Aggregation point for smallholders — bulking, vouching and coordination.',
   bullets:['Registration cert + PACRA + member list','Verify members (Tier 2)','Aggregate produce into bulk lots','Manage collection & transport','Apply to large bids','Rate buyers']},
  {name:'Company Buyer', desc:'Processors, retailers and exporters procuring at scale.',
   bullets:['PACRA + TIN + physical address','Post full-spec demand bids','Search listings by crop, grade, tier','Procure through cooperatives','Message farmers directly','View supply trends']},
  {name:'Business Operator', desc:'Suppliers of eggs, fish, poultry and livestock.',
   bullets:['National ID (optional business name/TIN)','List availability','Search for buyers','Message buyers','Build reputation']},
  {name:'General Account', desc:'Individual business persons, sole traders and market vendors.',
   bullets:['Phone + national ID (Tier 1)','Create buyer profile','Search listings','Post demand up to 50t','Message farmers','Rate farmers']}
];

function renderUserCards(){
  document.getElementById('userCards').innerHTML = USER_TYPES.map(u=>`
    <div class="card usertype" onclick="toast('${u.name} account selected — demo only.')">
      <h4>${u.name} Account</h4>
      <p class="muted">${u.desc}</p>
      <ul>${u.bullets.map(b=>`<li>${b}</li>`).join('')}</ul>
    </div>`).join('');
}

/* ============================================================
   INIT
   ============================================================ */
function init(){
  renderDashBids();
  renderBids();
  calcLoss();
  renderLossEntries();
  renderLossMap('dashLossMap');
  renderLossMap('lossMapFull');
  renderHubs();
  renderReceipts();
  renderUserCards();
  renderSmsInbox();
  updateKPIs();
  addSms('demand', 'Welcome to FarmLink');
  addSms('fra', 'FRA buying window');
}
init();
</script>
</body>
</html>